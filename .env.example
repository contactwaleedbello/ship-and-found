# ==============================================================================
# DG TECH STORE — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Source: PRD Section 8.5 and .agents/rules/env-and-secrets.md
# Copy to .env.local for local development. Never commit real secrets.
# ==============================================================================

# 1. PostgreSQL Connection String (lib/db.ts, prisma/schema.prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dg_tech_store?schema=public"

# 2. NextAuth Session Signing Secret — min 32 bytes base64 (lib/auth)
NEXTAUTH_SECRET="dev-only-replace-with-32-byte-base64-secret-00000000"

# 3. Canonical Base URL (lib/auth)
NEXTAUTH_URL="http://localhost:3000"

# 4. AES-256-GCM Key for CustomerProfile.nin (64 hex chars = 32 bytes)
NIN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 5. AES-256-GCM Key for CustomerProfile.phone_number (64 hex chars = 32 bytes)
PHONE_ENCRYPTION_KEY="fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

# 6. Nigerian SMS Provider API Key for 6-digit OTPs (Termii / Africa's Talking)
SMS_API_KEY="dev-sms-api-key-placeholder"

# 7. SMS Approved Transactional Sender ID
SMS_SENDER_ID="DGTechATF03"

# 8. Vercel Cron Bearer Token — min 32 chars (app/api/cron/*)
CRON_SECRET="dev-only-cron-secret-minimum-32-characters-long"

# 9. Sentry Server-Side DSN (optional in local development)
SENTRY_DSN=""

# 10. Sentry Browser-Side DSN (only permitted NEXT_PUBLIC_* variable)
NEXT_PUBLIC_SENTRY_DSN=""

