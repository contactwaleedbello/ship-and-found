// ============================================================================
// DG TECH STORE (SHOP ATF 03) — PRISMA SCHEMA
// Task 4: The Server is the Source of Truth
// Rules:
// - Foreign keys enforce onDelete: Restrict
// - Money represented as Int (whole Naira ₦)
// - Slow hashing standard (Argon2id)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String           @id @default(uuid())
  fullName        String
  phoneNumber     String           @unique
  email           String           @unique
  passwordHash    String
  role            String           @default("CUSTOMER")
  ninEncrypted    String?
  isVerified      Boolean          @default(false)
  emailVerifiedAt     DateTime?
  bvnNumber           String
  creditScore         Int              @default(700)
  accountStatus       String           @default("ACTIVE")
  deletionRequestedAt DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  sessions        Session[]
  payments        Payment[]
  paymentAttempts PaymentAttempt[]

  @@index([role])
  @@index([accountStatus])
}

model Session {
  id           String    @id @default(uuid())
  sessionToken String    @unique
  userId       String
  ipAddress    String
  userAgent    String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model Payment {
  id               String         @id @default(uuid())
  paymentReference String         @unique
  paymentAttemptId String         @unique
  userId           String
  deviceId         String
  amountNaira      Int
  paymentType      String
  gatewayReference String
  receiptNumber    String         @unique
  settledAt        DateTime
  createdAt        DateTime       @default(now())

  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempt          PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@index([userId, settledAt])
}

model PaymentAttempt {
  id                  String    @id @default(uuid())
  attemptReference    String    @unique
  userId              String
  deviceId            String
  intendedAmountNaira Int
  channel             String
  status              String
  gatewayErrorCode    String?
  gatewayErrorMessage String?
  ipAddress           String
  startedAt           DateTime  @default(now())
  endedAt             DateTime?

  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment             Payment?

  @@index([status, startedAt])
}

model KnowledgeChunk {
  id            String   @id @default(uuid())
  documentTitle String
  sourceUrl     String
  chunkIndex    Int
  content       String
  tokenCount    Int
  embeddingJson String?
  createdAt     DateTime @default(now())

  @@index([documentTitle, chunkIndex])
}
